{
  "name": "@dtc/design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": { ".": "./src/index.ts", "./styles.css": "./src/styles.css" },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
